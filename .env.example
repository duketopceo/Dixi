# Backend Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
WS_PORT=3002

# Vision Service
VISION_SERVICE_URL=http://localhost:5001
VISION_SERVICE_PORT=5001
BACKEND_URL=http://localhost:3001

# Ollama Configuration (REQUIRED for AI features)
# Ollama must be installed and running before starting services
# Install: https://ollama.ai
# Start: ollama serve
# Pull models: ollama pull gemma3:4b && ollama pull llava:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=llava:7b

# AI Provider (optional): 'ollama' (default, local) or 'gemini' (cloud)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# CLOUD_MODEL=gemini-1.5-flash
